---
import { siteConfig } from '../data/siteConfig';

const waHref = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.defaultWhatsAppMessage)}`;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-charcoal/10 bg-charcoal text-cream">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand Info -->
      <div class="space-y-4">
        <div>
          <p class="font-serif text-2xl font-bold text-cream">{siteConfig.name}</p>
          <p class="text-xs uppercase tracking-widest text-sand/75">
            {siteConfig.locality} • Dal {siteConfig.foundedYear}
          </p>
        </div>
        <p class="text-sm leading-relaxed text-sand/85">
          Dal 1978 a Olza: salumi e primi della tradizione piacentina, specialità di pesce e dolci fatti in casa, tra la veranda aperta sul giardino e la sala con stufa in maiolica.
        </p>
      </div>

      <!-- Indirizzo & Contatti -->
      <div class="space-y-3">
        <h3 class="font-serif text-xl font-semibold text-cream">Dove Siamo &amp; Contatti</h3>
        <address class="not-italic space-y-2 text-sm text-sand/85">
          <p>{siteConfig.address}</p>
          <p>
            <a
              href={siteConfig.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-medium text-terracotta-light underline underline-offset-4 hover:text-cream"
            >
              Apri su Google Maps
              <span aria-hidden="true">→</span>
            </a>
          </p>
          <p class="pt-1">
            Tel:
            <a
              href={`tel:${siteConfig.phoneRaw}`}
              class="font-semibold text-cream underline decoration-terracotta-light/60 underline-offset-4 hover:text-terracotta-light"
            >
              {siteConfig.phoneDisplay}
            </a>
          </p>
          <p>
            WhatsApp:
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-whatsapp hover:underline"
            >
              Scrivici su WhatsApp
            </a>
          </p>
          <p>
            Email:
            <a href={`mailto:${siteConfig.email}`} class="hover:text-cream hover:underline">
              {siteConfig.email}
            </a>
          </p>
        </address>
      </div>

      <!-- Orari -->
      <div class="space-y-3">
        <h3 class="font-serif text-xl font-semibold text-cream">Orari di Apertura</h3>
        <dl class="space-y-2 text-sm">
          {
            siteConfig.openingHours.map((item) => (
              <div class="flex flex-col border-b border-cream/10 pb-1.5">
                <dt class="font-semibold text-cream">{item.days}</dt>
                <dd class={item.hours === 'Chiuso' ? 'font-medium text-terracotta-light' : 'text-sand/85'}>
                  {item.hours}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Note Utili -->
      <div class="space-y-3">
        <h3 class="font-serif text-xl font-semibold text-cream">Informazioni Utili</h3>
        <ul class="space-y-2 text-sm leading-relaxed text-sand/85">
          <li>• Ampio parcheggio gratuito adiacente</li>
          <li>• Accesso agevole senza barriere in veranda</li>
          <li>• Menu dedicato per pranzo di lavoro (Mar–Ven)</li>
          <li>• {siteConfig.allergenNote}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-cream/15 pt-8 text-xs text-sand/70 sm:flex-row">
      <p>© {currentYear} {siteConfig.name} — Olza di Monticelli d'Ongina (PC). Tutti i diritti riservati.</p>
      <nav aria-label="Link rapidi footer" class="flex gap-5">
        <a href="/" class="hover:text-cream">Home</a>
        <a href="/menu" class="hover:text-cream">Menu Completo</a>
        <a href="/chi-siamo" class="hover:text-cream">Chi Siamo</a>
        <a href="/gallery" class="hover:text-cream">Gallery</a>
      </nav>
    </div>
  </div>
</footer>
