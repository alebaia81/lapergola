---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/paths';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const waHref = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.defaultWhatsAppMessage)}`;

const navLinks = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/menu'), label: 'Il Menu' },
  { href: withBase('/chi-siamo'), label: 'Chi Siamo' },
  { href: withBase('/gallery'), label: 'Gallery' },
  { href: withBase('/#contatti'), label: 'Contatti' },
];
---

<header class="sticky top-0 z-50 border-b border-charcoal/10 bg-cream/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a
      href={withBase('/')}
      class="group flex flex-col rounded-md focus-visible:outline-none"
      aria-label={`${siteConfig.name} — Torna alla homepage`}
    >
      <span class="font-serif text-xl font-bold tracking-tight text-charcoal transition-colors group-hover:text-terracotta sm:text-2xl">
        {siteConfig.name}
      </span>
      <span class="text-[11px] font-medium uppercase tracking-widest text-warmgray">
        Olza • Dal {siteConfig.foundedYear}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Navigazione principale" class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => {
          const normalizedHref = link.href.replace(/\/+$/, '') || '/';
          const isActive = !link.href.includes('#') && currentPath === normalizedHref;
          return (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors hover:text-terracotta',
                isActive ? 'text-terracotta underline decoration-2 underline-offset-4' : 'text-charcoal',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Actions (WhatsApp CTA + Mobile Menu Toggle) -->
    <div class="flex items-center gap-2.5">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-whatsapp px-3.5 py-2 text-xs font-bold text-whatsapp-ink shadow-sm transition-colors hover:bg-[#1ebe5d] sm:px-4 sm:text-sm"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.891-.125-.438-.141-.984-.328-1.703-.641-3-1.297-4.953-4.328-5.109-4.531-.141-.203-1.219-1.625-1.219-3.094 0-1.469.766-2.188 1.047-2.484.266-.297.594-.375.797-.375.188 0 .391.016.563.016.188 0 .438-.078.672.5.25.594.844 2.063.922 2.219.078.141.125.313.031.516-.094.203-.141.328-.297.5-.141.172-.313.391-.438.516-.141.141-.297.297-.125.594.172.297.766 1.266 1.641 2.047 1.125 1 2.078 1.313 2.375 1.469.297.141.469.125.641-.078.172-.203.75-.875.953-1.172.203-.297.406-.25.672-.141.266.094 1.719.813 2.016.953.297.156.5.234.563.359.078.125.078.734-.172 1.438z" />
        </svg>
        <span class="hidden sm:inline">Prenota su WhatsApp</span>
        <span class="sm:hidden">Prenota</span>
      </a>

      <button
        type="button"
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Apri menu di navigazione"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-charcoal/15 bg-sand text-charcoal transition-colors hover:bg-terracotta hover:text-white lg:hidden"
      >
        <svg id="menu-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <nav
    id="mobile-menu"
    aria-label="Navigazione mobile"
    class="hidden border-t border-charcoal/10 bg-cream px-4 pb-5 pt-3 lg:hidden"
  >
    <ul class="flex flex-col space-y-2">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link block rounded-lg px-3 py-2.5 text-base font-medium text-charcoal transition-colors hover:bg-sand hover:text-terracotta"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu(forceClose = false) {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    const nextState = forceClose ? false : !isExpanded;

    btn.setAttribute('aria-expanded', String(nextState));
    menu.classList.toggle('hidden', !nextState);
    iconOpen.classList.toggle('hidden', nextState);
    iconClose.classList.toggle('hidden', !nextState);
  }

  btn?.addEventListener('click', () => toggleMenu());
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => toggleMenu(true));
  });
</script>
